{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "darmark",
  "version": "0.1.0",
  "identifier": "dev.darmark.app",
  "build": {
    "beforeDevCommand": "npm run sidecars:dev && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build && npm run sidecars",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "darmark — Markdown editor",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/darmark-plugin-host", "binaries/darmark-plugin"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "icon": ["icons/icon.ico"]
  }
}
